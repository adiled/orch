#!/bin/bash
# pre-push hook: regenerate grammar PDF and amend if it changed.
# Install: cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Requires: pdflatex (TinyTeX or any TeX Live distribution)

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PDF="$ROOT/docs/grammar.pdf"
TEX="$ROOT/docs/grammar.tex"

# Find pdflatex
PDFLATEX="${PDFLATEX:-$(command -v pdflatex 2>/dev/null || echo "$HOME/Library/TinyTeX/bin/universal-darwin/pdflatex")}"
if [ ! -x "$PDFLATEX" ]; then
    echo "pre-push: pdflatex not found, skipping grammar PDF generation"
    exit 0
fi

# Snapshot current PDF hash
old_hash=""
if [ -f "$PDF" ]; then
    old_hash=$(git hash-object "$PDF")
fi

# Regenerate (two passes for TOC)
cd "$ROOT/docs"
"$PDFLATEX" -interaction=nonstopmode grammar.tex >/dev/null 2>&1
"$PDFLATEX" -interaction=nonstopmode grammar.tex >/dev/null 2>&1

# Clean aux files
rm -f grammar.aux grammar.log grammar.toc grammar.out

new_hash=$(git hash-object "$PDF")

if [ "$old_hash" != "$new_hash" ]; then
    echo "pre-push: grammar.pdf changed, amending commit..."
    git add "$PDF"
    git commit --amend --no-edit --quiet
    echo "pre-push: commit amended with updated grammar.pdf"
fi
