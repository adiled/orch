#!/bin/bash
# pre-push hook: regenerate grammar SVG and amend if it changed.
# Install: cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
SVG="$ROOT/docs/grammar.svg"

# Snapshot current SVG hash
old_hash=""
if [ -f "$SVG" ]; then
    old_hash=$(git hash-object "$SVG")
fi

# Regenerate
python3 "$ROOT/scripts/gen-grammar-svg.py" >/dev/null 2>&1

new_hash=$(git hash-object "$SVG")

if [ "$old_hash" != "$new_hash" ]; then
    echo "pre-push: grammar.svg changed, amending commit..."
    git add "$SVG"
    git commit --amend --no-edit --quiet
    echo "pre-push: commit amended with updated grammar.svg"
fi
